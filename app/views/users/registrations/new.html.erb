<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">

      <h2 class="text-center mb-4">新規登録</h2>

      <div class="gift-panel">

        <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>

          <%= render "users/shared/error_messages", resource: resource %>

          <div class="mb-4">
            <%= f.label :name, "ユーザー名", class: "form-label" %>
            <%= f.text_field :name, autofocus: true, autocomplete: "nickname", class: "form-control" %>
          </div>

          <div class="mb-4">
            <%= f.label :email, "メールアドレス", class: "form-label" %>
            <%= f.email_field :email, autocomplete: "email", class: "form-control" %>
          </div>

          <div class="mb-4">
            <%= f.label :password, "パスワード", class: "form-label" %>

            <% if @minimum_password_length %>
              <small class="text-muted d-block mb-2">
                ※ <%= @minimum_password_length %>文字以上
              </small>
            <% end %>

            <%= f.password_field :password,
                autocomplete: "new-password",
                class: "form-control" %>
          </div>

          <div class="mb-4">
            <%= f.label :password_confirmation, "パスワード（確認用）", class: "form-label" %>
            <%= f.password_field :password_confirmation,
                autocomplete: "new-password",
                class: "form-control" %>
          </div>

          <div class="text-center">
            <%= f.submit "新規登録", class: "btn btn-gift px-5" %>
          </div>

        <% end %>

        <hr class="my-4">

        <div class="text-center">
          <p class="mb-2">すでにアカウントをお持ちの方</p>
          <%= link_to "ログインはこちら",
              new_user_session_path,
              class: "btn btn-gift-outline" %>
        </div>

      </div>

    </div>
  </div>
</div>
