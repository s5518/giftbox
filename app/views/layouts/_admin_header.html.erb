<header class="gift-header">
  <nav class="navbar navbar-expand-lg">
    <div class="container">
      <%= link_to admin_root_path, class: "navbar-brand gift-logo" do %>
        <%= image_tag "giftbox.PNG", alt: "GiftBox", height: "90" %>
      <% end %>

      <div class="navbar-nav ms-auto gap-2">
        <% if admin_signed_in? %>
          <%= link_to "投稿一覧", admin_posts_path, class: "btn btn-gift-outline me-2" %>
          <%= link_to "ユーザー一覧", admin_users_path, class: "btn btn-gift-outline me-2" %>
          <%= link_to "タグ一覧", admin_tags_path, class: "btn btn-gift-outline me-2" %>
          <%= link_to "ログアウト", destroy_admin_session_path, data: { turbo_method: :delete }, class: "btn btn-gift-outline" %>
        <% end %>
      </div>
    </div>
  </nav>
</header>
