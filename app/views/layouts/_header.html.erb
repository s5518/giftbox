<header class="gift-header">
  <nav class="navbar navbar-expand-lg">
    <div class="container">
      <%= link_to root_path, class: "navbar-brand gift-logo" do %>
        <%= image_tag "giftbox.PNG", alt: "GiftBox", height: "140" %>
      <% end %>

      <div class="navbar-nav ms-auto gap-2">
        <% if user_signed_in? %>
          <%= link_to "マイページ", mypage_path, class: "btn btn-gift-outline me-2" %>
          <%= link_to "投稿一覧", posts_path, class: "btn btn-gift-outline me-2" %>
          <%= link_to "ユーザー一覧", users_path, class: "btn btn-gift-outline me-2" %>
          <%= link_to "ログアウト",
                  destroy_user_session_path,
                  data: { turbo_method: :delete },
                  class: "btn btn-gift-outline me-2" %>
        <% else %>
          <%= link_to "トップ", root_path, class: "btn btn-gift-outline me-2" %>
          <%= link_to "About", about_path, class: "btn btn-gift-outline me-2" %>
          <%= link_to "新規登録", new_user_registration_path, class: "btn btn-gift-outline me-2" %>
          <%= link_to "ログイン", new_user_session_path, class: "btn btn-gift-outline me-2" %>
        <% end %>
      </div>
    </div>
  </nav>
</header>