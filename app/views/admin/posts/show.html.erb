<div class="container py-5">
  <h2 class="ms-5 mb-4">投稿詳細</h2>

  <div class="row justify-content-center">
    <div class="col-md-8">

      <div class="gift-panel">

        <div class="row align-items-center">

          <!-- 左側：プレゼント画像 -->
          <div class="col-md-6">
            <% if @post.image.attached? %>
              <%= image_tag @post.image, class: "post-detail-image" %>
            <% else %>
              <%= image_tag "image.PNG", class: "post-detail-image" %>
            <% end %>
          </div>

          <!-- 右側：プレゼント情報 -->
          <div class="col-md-6">
            <h3 class="mb-4"><%= @post.gift_name %></h3>

            <p>受け取った人：<%= @post.age %>歳</p>
            <p>金額：¥<%= number_with_delimiter(@post.price) %></p>
          </div>

        </div>

        <!-- 下側：レビュー -->
        <div class="mt-4">
          <h5>レビュー内容</h5>
          <hr>
          <p><%= simple_format(@post.content) %></p>
        </div>

        <p class="mt-4">
          投稿者：<%= link_to @post.user.name, admin_user_path(@post.user) %>
        </p>

        <p><%= render "public/posts/tags", post: @post %></p>

        <div class="d-flex gap-3 mt-4 mb-4">
          <%= link_to "削除する", admin_post_path(@post),
                                 data: {
                                  turbo_method: :delete,
                                  turbo_confirm: "本当に削除しますか？"
                                 },class: "btn btn-outline-danger rounded-pill" %>
        </div>

        <div id="comments">
          <%= render "public/comments/index", post: @post %>
        </div>

        <%= link_to "一覧に戻る", admin_posts_path,
            class: "btn btn-outline-secondary rounded-pill" %>

      </div>

    </div>
  </div>
</div>
