<div class="container my-5">
  <div class="row mb-4">
    <div class="col-md-10 offset-md-1">
      <h2 class="mb-4">投稿一覧</h2>

      <table class="table">
        <thead class="table-light">
          <tr>
            <th>投稿ID</th>
            <th>投稿者</th>
            <th>プレゼント名</th>
            <th>投稿日</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @posts.each do |post| %>
            <tr>
              <td><%= post.id %></td>
              <td>
                <%= link_to post.user.name, admin_user_path(post.user) %>
              </td>
              <td>
                <%= link_to post.gift_name, admin_post_path(post) %>
              </td>
              <td>
                <%= post.created_at.strftime('%m/%d') %>
              </td>
              <td>
                <%= link_to "削除", admin_post_path(post),
                                    data: {
                                      turbo_method: :delete,
                                      turbo_confirm: "本当に削除しますか？"
                                    },
                                    class: "btn btn-outline-danger rounded-pill" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>