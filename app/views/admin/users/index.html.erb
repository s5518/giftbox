<div class="container my-5">
  <div class="row mb-4">
    <div class="col-md-10 offset-md-1">
      <h2 class="mb-4">ユーザー一覧</h2>

      <table class="table">
        <thead class="table-light">
          <tr>
            <th>ユーザーID</th>
            <th>名前</th>
            <th>メールアドレス</th>
            <th>登録日</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr>
              <td><%= user.id %></td>
              <td>
                <%= link_to user.name, admin_user_path(user) %>
              </td>
              <td>
                <%= user.email %>
              </td>
              <td>
                <%= user.created_at.strftime('%m/%d') %>
              </td>
              <td>
                <%= link_to "削除", admin_user_path(user),
                                    data: {
                                      turbo_method: :delete,
                                      turbo_confirm: "本当に削除しますか？"
                                    },
                                    class: "btn btn-outline-danger rounded-pill" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <%= link_to "トップページに戻る", admin_posts_path, class: "btn btn-outline-secondary rounded-pill" %>
    </div>
  </div>
</div>
