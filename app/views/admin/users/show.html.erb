<div class="container my-5">
  <div class="row">
    <div class="col-md-10 offset-md-1">

      <h2 class="mb-4">ユーザー詳細</h2>

      <table class="table">
        <tr>
          <th class="table-light" style="width: 30%;">ユーザーID</th>
          <td><%= @user.id %></td>
        </tr>
        <tr>
          <th class="table-light">名前</th>
          <td><%= @user.name %></td>
        </tr>
        <tr>
          <th class="table-light">メールアドレス</th>
          <td><%= @user.email %></td>
        </tr>
        <tr>
          <th class="table-light">自己紹介</th>
          <td><%= @user.introduction.presence || "未設定" %></td>
        </tr>
        <tr>
          <th class="table-light">登録日</th>
          <td><%= @user.created_at.strftime("%Y/%m/%d") %></td>
        </tr>
      </table>

      <%= link_to "ユーザーを退会させる", admin_user_path(@user),
            data: {
              turbo_method: :delete,
              turbo_confirm: "このユーザーを退会させますか？ この操作は取り消せません。"
            },
            class: "btn btn-outline-danger rounded-pill" %>

      <h4 class="mt-4 mb-3">投稿一覧（<%= @posts.count %>件）</h4>

      <table class="table">
        <thead class="table-light">
          <tr>
            <th>投稿ID</th>
            <th>プレゼント名</th>
            <th>投稿日</th>
            <th></th>
          </tr>
        </thead>

        <tbody>
          <% @posts.each do |post| %>
            <tr>
              <td><%= post.id %></td>
              <td>
                <%= link_to post.gift_name, admin_post_path(post) %>
              </td>
              <td><%= post.created_at.strftime("%Y/%m/%d") %></td>
              <td>
                <%= link_to "削除", admin_post_path(post),
                                    data: {
                                      turbo_method: :delete,
                                      turbo_confirm: "本当に削除しますか？"
                                    },
                                    class: "btn btn-outline-danger rounded-pill" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <% if @posts.empty? %>
        <p>まだ投稿はありません。</p>
      <% end %>

      
        <%= link_to "一覧に戻る", admin_users_path,
            class: "btn btn-outline-secondary rounded-pill" %>
      

    </div>
  </div>
</div>
