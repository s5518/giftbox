<div class="container my-5">
  <div class="row">
    <div class="col-md-10 offset-md-1">
      <h2 class="mb-4">タグ編集</h2>

      <% if @tag.errors.any? %>
        <div class="alert alert-danger">
          <p>入力内容にエラーがあります。</p>
          <ul class="mb-0">
            <% @tag.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @tag, url: admin_tag_path(@tag) do |f| %>
        <div class="row align-items-end g-3 mb-4">
          <div class="col-md-3">
            <%= f.label :category, "カテゴリー", class: "form-label" %>
            <%= f.select :category, [["関係性","関係性"], ["種類","種類"], ["シーン","シーン"]],
                                    { include_blank: "選択して下さい" }, { class: "form-select" } %>
          </div>
          <div class="col-md-5">
            <%= f.label :name, "タグ名", class: "form-label" %>
            <%= f.text_field :name, class: "form-control"  %>
          </div>

          <div class="col-md-2">
            <%= f.submit "変更を保存", class: "btn btn-sm btn-gift-outline" %>
          </div>
        </div>
      <% end %>

      <%= link_to "一覧に戻る", admin_tags_path, class: "btn btn-outline-secondary rounded-pill" %>
    </div>
  </div>
</div>
