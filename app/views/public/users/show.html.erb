<div class="container py-5">
  <h2 class="ms-5 mb-5">
    <%= @user == current_user ? "マイページ" : "ユーザー詳細" %>
  </h2>
  <div class="profile-card">
    <div class="profile-card-content">

      <div class="profile-image-placeholder mx-auto">
        <% if @user.profile_image.attached? %>
          <%= image_tag @user.profile_image, size: "160x160" %>
        <% else %>
          <i class="fa-solid fa-user fa-6x"></i>
        <% end %>
      </div>

      <div class="profile-info">
        <h3 class="mb-3"><%= @user.name %></h3>

        <p>
          <%= @user.introduction.presence || "自己紹介はまだありません" %>
        </p>

        <% if @user == current_user && !current_user.guest_user? %>
          <div class="d-flex flex-warp gap-2 mt-3">
            <%= link_to "プロフィール編集",
                         edit_user_path(@user),
                         class: "btn btn-gift-outline mt-2" %>

            <%= link_to "＋ 新規投稿", new_post_path, class: "btn btn-gift mt-2" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <h2 class="ms-5 mb-4">投稿したレビュー</h2>

  <div class="row g-4">
    <% @posts.each do |post| %>
      <div class="col-md-3">
        <div class="gift-card p-2">

          <!-- 画像部分 -->
          <%= link_to post_path(post) do %>
            <% if post.image.attached? %>
              <%= image_tag post.image, class: "gift-card-image" %>
            <% else %>
              <div class="gift-card-no-image">
                <%= image_tag "image.PNG", alt: "NO IMAGE", class: "gift-card-image" %>
              </div>
            <% end %>
          <% end %>

          <!-- アイテム説明部分 -->
          <div class="gift-card-body ms-2">

            <h5 class="mt-2">
              <%= link_to post.gift_name,post_path(post),class: "gift-card-title" %>
            </h5>

            <%= render "public/posts/rating", post: post %>

            <p>受け取った人：<%= post.age %>歳</p>
            <p>¥<%= number_with_delimiter(post.price) %></p>
            <p><%= render "public/posts/tags", post: post %></p>
            <p>
              <i class="fa-regular fa-comment"></i>
              <span><%= post.comments.count %></span>
            </p>
          </div>

        </div>
      </div>
    <% end %>
  </div>
</div>
