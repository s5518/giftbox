<h1>ユーザー詳細</h1>

<p>
  <strong>ユーザー名：</strong>
  <%= @user.name %>
</p>

<p>
  <strong>自己紹介：</strong>
  <%= @user.introduction %>
</p>

<% if @user == current_user %>
  <%= link_to "プロフィールを編集", edit_user_path(@user) %>

  <%= link_to "退会する",
              user_path(@user),
              data: {
                turbo_method: :delete,
                turbo_confirm: "本当に退会しますか？"
              } %>
<% end %>

<h2>投稿したプレゼント</h2>

<% @posts.each do |post| %>
  <div>
    <%= link_to post.gift_name, post_path(post) %>
    <p>受け取った人の年齢：<%= post.age %>歳</p>
    <p>金額：<%= post.price %>円</p>
  </div>
<% end %>

<%= link_to "ユーザー一覧へ", users_path %>
