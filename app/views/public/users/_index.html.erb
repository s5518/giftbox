<div class="row justify-content-center">
  <div class="col-md-8">

    <% users.each do |user| %>
      <div class="d-flex align-items-center gap-3 mb-3 p-3 user-card">

        <% if user.profile_image.attached? %>
          <%= image_tag user.profile_image, class: "user-list-image" %>
        <% else %>
          <div class="user-list-image-placeholder"></div>
        <% end %>

        <div>
          <h5>
            <%= link_to user.name, user_path(user), class: "gift-card-title" %>
          </h5>
          <p class="mb-0">
            <%= user.introduction.presence || "自己紹介はまだありません" %>
          </p>
        </div>

      </div>
    <% end %>

  </div>
</div>