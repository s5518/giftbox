<h1>マイページ</h1>

<div>
  <p>
    <strong>ユーザー名：</strong>
    <%= @user.name %>
  </p>

  <p>
    <strong>自己紹介：</strong>
    <%= @user.introduction %>
  </p>

  <%= link_to "プロフィール編集", edit_user_path(@user) %>
</div>

<h2>投稿したプレゼント</h2>

<% @posts.each do |post| %>
  <div>
    <%= link_to post.gift_name, post_path(post) %>
    <p>受け取った人の年齢：<%= post.age %>歳</p>
    <p>金額：<%= post.price %>円</p>
  </div>
<% end %>
