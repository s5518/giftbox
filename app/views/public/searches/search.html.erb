<div class="container py-5">
  <h2 class="mb-4">検索結果</h2>

  <p class="mb-4">
    <% if @model == "user" %>
      ユーザー
    <% elsif @model == "tag" %>
      タグ
    <% else %>
      投稿
    <% end %>の検索結果：
    <strong><%= @records.count %>件</strong>
  </p>

  <% if @records.exists? %>
    <% if @model == "user" %>
      <%= render "public/users/index", users: @records %>
    <% else %>
      <%= render "public/posts/index", posts: @records %>
    <% end %>
  <% else %>
    <div class="text-center py-5">
      <i class="fa-solid fa-magnifying-glass fa-2x mb-3 text-muted"></i>
      <h5>該当する検索結果がありません</h5>
      <p class="text-muted">
        キーワードを変更して、もう一度検索してみてください。
      </p>
    </div>
  <% end %>
</div>