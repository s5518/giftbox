<% if user_signed_in? %>
  <div class="search-bar-container">
    <%= form_with url: search_path, method: :get, local: true, class: "search-form" do |f| %>

      <%= f.select :model, options_for_select(
                           { "投稿" => "post", "ユーザー" => "user" },
                           params[:model] || "post"
                           ),{},class: "search-select" %>

      <%= f.text_field :content, value: params[:content],
                                 placeholder: "キーワードを入力",
                                 class: "search-input" %>

      <%= f.button type: "submit", class: "search-button" do %>
        <i class="fa-solid fa-magnifying-glass"></i>
        <span>検索</span>
      <% end %>

    <% end %>
  </div>
<% end %>
