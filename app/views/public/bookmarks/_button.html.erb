<% if post.bookmarked_by?(current_user) %>
  <%= link_to post_bookmark_path(post),data: { turbo_method: :delete , turbo_stream: true } do %>
    <i class="fa-solid fa-bookmark fs-3"></i>
  <% end %>
<% else %>
  <%= link_to post_bookmark_path(post), data: { turbo_method: :post , turbo_stream: true } do %>
    <i class="fa-regular fa-bookmark fs-3"></i>
  <% end %>
<% end %>
