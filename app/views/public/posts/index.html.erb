<h1>投稿一覧</h1>

<div>
  <%= link_to "新規投稿", new_post_path, class: "btn btn-success" %>
</div>

<% @posts.each do |post| %>
  <div>
    <%= link_to post.gift_name, post_path(post) %>
  </div>
  <div>
    <p>受け取った人の年齢：<%= post.age %>歳</p>
    <p>金額：<%= post.price %>円</p>
    <p>
      投稿者：<%= link_to post.user.name, user_path(post.user) %>
    </p>
  </div>
<% end %>
