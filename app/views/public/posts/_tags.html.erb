<div class="mb-3">
  <% if post.tags.any? %>
    <div class="d-flex flex-wrap gap-2">
      <% post.tags.each do |tag| %>
        <span class="badge rounded-pill bg-light text-dark border">
          <%= link_to tag.name, posts_path(tag_id: tag.id) %>
        </span>
      <% end %>
    </div>
  <% end %>
</div>
