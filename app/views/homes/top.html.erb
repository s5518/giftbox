<div class="container py-5">

  <div class="text-center py-5">

    <h1 class="gift-top-title mb-4">
      <i class="fa-solid fa-gift"></i>
      GiftBox
    </h1>

    <h3 class="mb-4">
      大切な人への贈り物に、ヒントを。
    </h3>

    <%= link_to about_path, class: "gift-top-description text-arline-none" do %>
      GiftBoxとは？
    <% end %>

    <div class="d-flex justify-content-center gap-3 mt-4 mb-4">
